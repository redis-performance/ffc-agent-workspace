+  // spans and run the full algorithm (compute_float disambiguation + digit_comp).
+  if (pns.too_many_digits) {
+    pns = bjf ? parse_number_string<true, UC, true>(first, last, options)
+              : parse_number_string<false, UC, true>(first, last, options);
+    return from_chars_advanced(pns, value);
+  }
